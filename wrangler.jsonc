{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beauty-abode",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "beauty-abode-staging" }
  ]
}
